# Engine-analysis cache (regenerated on demand, can be large)
cache/
# Generated human baselines and reports
baselines/
*.report.json
report.md
report.json
# Downloaded/filtered human corpora (can be large)
corpora/
# Orchestrator working dir (fetched games, reports) -- except the sweep
# driver scripts themselves, which are code, not generated output.
runs/*
!runs/breadth_sweep/
runs/breadth_sweep/*
!runs/breadth_sweep/run_sweep.py
!runs/strength_dial/
runs/strength_dial/*
!runs/strength_dial/run_phase_a.py
!runs/strength_dial/run_phase_b.py
!runs/strength_dial/run_phase_c.py
!runs/strength_dial/run_phase_d.py
# The human rating-band tables are the calibration TARGET for the strength
# dial and every human-likeness comparison -- not bulk output. Small (~10KB),
# and not reliably reproducible: regenerating costs ~65 min of compute AND
# needs corpora/, which is gitignored and came from Lichess.
!runs/elo_progression/
runs/elo_progression/*
!runs/elo_progression/report_timing.md
!runs/elo_progression/report_longthink.md
